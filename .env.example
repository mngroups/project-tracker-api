# Copy to .env for `pnpm dev`. Values below match docker-compose.yml and `pnpm dev:issuer`.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgres://monexa:monexa@localhost:5433/monexa
# Vercel: point at a pooler (PgBouncer transaction mode) and keep this at 1-3.
DB_POOL_MAX=10

# credentials = in-app login form; sso = OIDC redirect (needs AUTH_REDIRECT_URIS).
# Defaults below use `pnpm dev:issuer`. Against monexa-auth (README, "Sign in with
# monexa-auth"): AUTH_MODE=sso, AUTH_ISSUER=http://localhost:9000/oidc and the client
# secret the admin UI showed when the app was created.
AUTH_MODE=credentials
AUTH_ISSUER=http://localhost:9000
AUTH_CLIENT_ID=project-tracker
AUTH_CLIENT_SECRET=dev-secret
# Comma-separated FE callback URLs allowed in sso mode.
AUTH_REDIRECT_URIS=http://localhost:3000/auth/callback
# sso only, e.g. google
AUTH_IDP_HINT=
# sso only: an org slug that brands the central login page. Leave empty when this
# deployment serves several client orgs.
AUTH_ORG_HINT=
AUTH_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/login

# Comma-separated; empty = no CORS (the FE calls this API from the server).
CORS_ORIGINS=
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10
# true behind a proxy that sets X-Forwarded-For (load balancer, Vercel).
TRUST_PROXY=false

S3_BUCKET=monexa-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9002
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
UPLOAD_MAX_BYTES=26214400
UPLOAD_ALLOWED_TYPES=application/pdf,image/png,image/jpeg,image/webp,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/zip,text/plain,text/csv
