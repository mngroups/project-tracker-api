{
  "name": "project-tracker-api",
  "version": "0.1.0",
  "private": true,
  "description": "Project Tracker backend: Fastify on @mono/server-kit, Postgres/Drizzle, org-scoped.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R src/db/migrations dist/db/migrations",
    "start": "node dist/server.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "lint-staged",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "openapi": "tsx scripts/openapi.ts",
    "dev:issuer": "tsx scripts/dev-issuer.ts",
    "registry:run": "node scripts/with-gitlab-registry-auth.mjs",
    "deps:mono": "node scripts/with-gitlab-registry-auth.mjs update \"@mono/*\" --latest"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,json,jsonc,md}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@mono/auth": "0.3.0",
    "@mono/server-kit": "^0.4.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "openapi-types": "^12.1.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
